# Salin file ini menjadi .env untuk pengembangan lokal.
# Untuk produksi, isi nilai yang sama di dashboard RunxBuild
# (Environment Variables) — jangan commit file .env.

# URL project Supabase, contoh: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key Supabase (server-side, rahasia)
SUPABASE_SERVICE_KEY=

# API key Groq untuk fitur chat
GROQ_API_KEY=

# Port yang dipakai server. RunxBuild menginject PORT otomatis.
PORT=8080

# Origin frontend yang diizinkan CORS, dipisah koma.
# Contoh: http://localhost:5173,https://tuwangapp.vercel.app
CORS_ORIGINS=http://localhost:5173
