# Salin file ini menjadi .env untuk pengembangan lokal.
# Untuk produksi, isi nilai yang sama di dashboard Vercel/Render
# (Environment Variables) — jangan commit file .env.

# URL project Supabase, contoh: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key Supabase (server-side, rahasia)
SUPABASE_SERVICE_KEY=

# API key Groq untuk fitur chat
GROQ_API_KEY=

# Port yang dipakai server. Vercel/Render menginject PORT otomatis;
# jangan set PORT di production.
PORT=8080

# Zona waktu untuk batas "hari ini"/"bulan ini".
# Vercel reserves TZ, jadi gunakan APP_TZ=Asia/Jakarta di production.
APP_TZ=Asia/Jakarta

# Mode Gin saat production (opsional; jangan aktifkan saat debug lokal).
# GIN_MODE=release

# Origin frontend yang diizinkan CORS, dipisah koma.
# Contoh: http://localhost:5173,https://tuwangapp.vercel.app
CORS_ORIGINS=http://localhost:5173
